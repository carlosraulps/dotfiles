 *
 * Author : Aditya Shakya (adi1090x)
 * Github : @adi1090x
 * 
 * Configuration For Rofi Version: 1.7.3
 **/

configuration {
	/*---------- General setting ----------*/
	modi: "drun,window,finder:~/.config/rofi/scripts/finder.py,calc:~/.config/rofi/scripts/calc.py,filebrowser,run";
	case-sensitive: false;
	cycle: true;
	filter: "";
	scroll-method: 0;
	normalize-match: true;
	show-icons: true;
	icon-theme: "Papirus";
	steal-focus: false;

	/*---------- Matching setting ----------*/
	matching: "normal";
	tokenize: true;

	/*---------- SSH settings ----------*/
	ssh-client: "ssh";
	ssh-command: "{terminal} -e {ssh-client} {host} [-p {port}]";
	parse-hosts: true;
	parse-known-hosts: true;

	/*---------- Drun settings ----------*/
	drun-categories: "";
	drun-match-fields: "name,generic,exec,categories,keywords";
	drun-display-format: "{name} [<span weight='light' size='small' alpha='60%'><i>({generic})</i></span>]";
	drun-show-actions: false;
	drun-url-launcher: "xdg-open";
	drun-use-desktop-cache: false;
	drun-reload-desktop-cache: false;
	drun {
		parse-user:   true;
		parse-system: true;
    }

	/*---------- Run settings ----------*/
	run-command: "{cmd}";
	run-list-command: "";
	run-shell-command: "{terminal} -e {cmd}";

	/*---------- Fallback Icon ----------*/
	run,drun {
		fallback-icon: "application-x-addon";
	}

	/*---------- Window switcher settings ----------*/
	window-match-fields: "title,class,role,name,desktop";
	window-command: "wmctrl -i -R {window}";
	window-format: "{w} · {c} · {t:0}";
	window-thumbnail: false;

	/*---------- History and Sorting ----------*/
	disable-history: false;
	sorting-method: "normal";
	max-history-size: 50;

	/*---------- Display setting with Nerd Font icons ----------*/
	display-drun: "  Apps";
	display-window: "  Windows";
	display-finder: "󰈔  Files";
	display-calc: "󰍹  Calc";
	display-filebrowser: "  Browse";
	display-run: "  Run";
	display-combi: "󰍜  Spotlight";

	/*---------- Misc setting ----------*/
	terminal: "alacritty";
	font: "UbuntuMono Nerd Font 12";
	sort: false;
	threads: 0;
	click-to-exit: true;

	/*---------- File browser settings ----------*/
    filebrowser {
      directories-first: true;
      sorting-method:    "name";
    }

	/*---------- Keybindings & Conflict Resolution ----------*/
	kb-remove-to-eol: "";
	kb-element-next: "";
	kb-element-prev: "";
	kb-mode-next: "Tab,Shift+Right,Control+Tab";
	kb-mode-previous: "Shift+Tab,Shift+Left,Control+ISO_Left_Tab";
	kb-row-down: "Down,Control+n,Control+j";
	kb-row-up: "Up,Control+p,Control+k";
	kb-accept-entry: "Control+m,Return,KP_Enter";
	kb-cancel: "Escape,Control+g,Control+bracketleft";
}

@theme "~/.config/rofi/themes/spotlight-dark.rasi"

