#!/bin/bash
# ==============================================================================
#  tmux-smart-attach — Isolated, Self-Cleaning, Subterminal-Capable Terminal
# ==============================================================================

# If already inside tmux, just launch user shell
if [ -n "$TMUX" ]; then
    exec /usr/bin/fish
fi

# Unique session name for this terminal window
SESSION_NAME="term-$$-$(date +%s%N | cut -b1-8)"

# Launch an isolated tmux session for this terminal window:
# 1. 'destroy-unattached on' guarantees that the moment this Alacritty window
#    is closed (Win+W, Ctrl+D, or typing exit), tmux immediately terminates
#    the session and its panes. Zero zombie/ghost windows will linger in the bar!
# 2. The top bar only displays panes and tabs active in THIS window.
# 3. Subterminal splits (Ctrl+b | and Ctrl+b -) remain fully functional.
exec tmux new-session -s "$SESSION_NAME" -n "term" \; \
    set-option -t "$SESSION_NAME" destroy-unattached on
