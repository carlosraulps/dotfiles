# ==============================================================================
#  ZATHURA CONFIGURATION - Minimalist, Fast & Modern PDF Document Viewer
# ==============================================================================

# ------------------------------------------------------------------------------
#  General & Window Behavior
# ------------------------------------------------------------------------------
set font                        "UbuntuMono Nerd Font 11"
set selection-clipboard         clipboard
set window-title-page           true
set window-title-basename       true
set statusbar-home-tilde        true
set statusbar-page-percent      true
set render-loading              true
set database                    "plain"

# ------------------------------------------------------------------------------
#  Layout & Scrolling
# ------------------------------------------------------------------------------
set adjust-open                 "width"
set pages-per-row               1
set page-padding                4
set scroll-step                 40
set scroll-page-aware           true
set scroll-full-overlap         0.01
set smooth-scroll               true

# Minimal UI (hide vertical scrollbar, show statusbar)
set guioptions                  "s"

# ------------------------------------------------------------------------------
#  Zoom Settings
# ------------------------------------------------------------------------------
set zoom-step                   10
set zoom-min                    10
set zoom-max                    1000

# ------------------------------------------------------------------------------
#  Color Inversion / Dark Mode (Recolor)
# ------------------------------------------------------------------------------
# Default to true for Dark Mode on launch (toggle anytime with 'r' or 'i')
set recolor                     true
set recolor-keephue             true
set recolor-reverse-video       true

# ------------------------------------------------------------------------------
#  Keybindings
# ------------------------------------------------------------------------------
# Toggle dark / light mode
map r                           recolor
map <C-r>                       recolor
map i                           recolor

# Zooming
map +                           zoom in
map -                           zoom out
map =                           zoom in
map 0                           zoom 100
map a                           adjust_window best-fit
map s                           adjust_window width
map f                           toggle_fullscreen

# Smooth Navigation
map j                           scroll down
map k                           scroll up
map h                           scroll left
map l                           scroll right
map J                           navigate next
map K                           navigate previous
map <C-d>                       scroll half-down
map <C-u>                       scroll half-up
map d                           scroll half-down
map u                           scroll half-up

# Document Operations
map R                           rotate
map b                           toggle_statusbar
map q                           quit

# Fullscreen specific adjustments
map [fullscreen] a              adjust_window best-fit
map [fullscreen] s              adjust_window width
map [fullscreen] f              toggle_fullscreen

# ------------------------------------------------------------------------------
#  Color Theme (OneDark by default - matches Qtile & Alacritty)
#  Alternative options in themes/: catppuccin-mocha, dracula, nord, tokyonight
# ------------------------------------------------------------------------------
include themes/onedark
