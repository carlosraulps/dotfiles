# ==============================================================================
#  OneDark / Mac-Arch Theme for Dunst Notification Daemon
#  Pixel-perfect synergy with Qtile Top Bar and Rofi Spotlight
# ==============================================================================

[global]
    ### Display & Geometry ###
    monitor = 0
    follow = mouse
    width = (320, 480)
    height = (60, 260)
    origin = top-right
    offset = 18x44
    scale = 0
    notification_limit = 5

    ### Progress Bar ###
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 180
    progress_bar_max_width = 380
    progress_bar_corner_radius = 4

    ### Visual Style & Padding ###
    indicate_hidden = yes
    transparency = 5
    separator_height = 2
    padding = 14
    horizontal_padding = 16
    text_icon_padding = 12
    frame_width = 2
    frame_color = "#61afef"
    gap_size = 8
    separator_color = frame
    sort = yes
    idle_threshold = 120

    ### Typography ###
    font = "UbuntuMono Nerd Font 11"
    line_height = 3
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    ### Icons ###
    enable_recursive_icon_lookup = true
    icon_theme = "breeze-dark, Adwaita, hicolor"
    icon_position = left
    min_icon_size = 24
    max_icon_size = 48

    ### History & Actions ###
    sticky_history = yes
    history_length = 20
    dmenu = /usr/bin/rofi -dmenu -p dunst:
    browser = /usr/bin/brave -new-tab
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 8
    ignore_dbusclose = false

    ### Mouse Actions ###
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1e222a"
    foreground = "#98a2b3"
    frame_color = "#384050"
    highlight = "#61afef"
    timeout = 6

[urgency_normal]
    background = "#1e222a"
    foreground = "#e2e6ed"
    frame_color = "#61afef"
    highlight = "#98c379"
    timeout = 8

[urgency_critical]
    background = "#281e22"
    foreground = "#f0f6fc"
    frame_color = "#e06c75"
    highlight = "#e5c07b"
    timeout = 0
